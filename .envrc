use flake

# NixOS' /etc/ssl/certs only ships ca-certificates.crt / ca-bundle.crt and no
# hashed <hash>.0 links, so workerd (BoringSSL) cannot discover a CA bundle and
# every outbound TLS request fails with "unable to get local issuer certificate".
# Point it at the combined bundle explicitly.
export SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
export NIX_SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
