# Base URL of the verifier worker (browser-facing).
PUBLIC_VERIFIER_URL=http://127.0.0.1:8787

# Deployed JobsManager contract address.
PUBLIC_JOBS_MANAGER_ADDRESS=

# Chain the app operates on (480 = World Chain, 11155111 = Sepolia, ...).
PUBLIC_CHAIN_ID=480

# World ID app_id / rp_id from the Developer Portal. rp_id must match the
# verifier's WORLD_RP_ID, and the action must match WORLD_ACTION.
PUBLIC_WORLD_APP_ID=
PUBLIC_WORLD_RP_ID=
PUBLIC_WORLD_ACTION=register
PUBLIC_WORLD_ENVIRONMENT=production

# ERC-20 address used as the registration stake asset (whitelisted on-chain).
PUBLIC_STAKE_ASSET=
