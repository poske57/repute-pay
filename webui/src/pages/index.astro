---
import Registration from "../components/Registration.tsx";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Registration">
  <header class="page-head">
    <h1>Registration</h1>
    <p class="muted">
      Register as a ReputePay client. Prove your personhood with World ID and stake.
    </p>
  </header>

  <Registration client:only="react" />
</Layout>

<style>
  .page-head h1 {
    margin: 0 0 0.25rem;
    font-size: 1.6rem;
  }
</style>
