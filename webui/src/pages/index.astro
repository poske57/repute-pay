---
import Layout from "../layouts/Layout.astro";

const verifierUrl = import.meta.env.PUBLIC_VERIFIER_URL ?? "http://127.0.0.1:8787";
---

<Layout>
  <main>
    <header>
      <h1>World ID 4.0 検証</h1>
      <p class="subtitle">
        IDKit で証明をリクエストし、verifier worker で検証します。verifier: <code>{verifierUrl}</code>
      </p>
    </header>

    <section class="card">
      <h2>設定</h2>
      <form id="verify-form">
        <div class="field">
          <label for="app-id">app_id</label>
          <input id="app-id" name="app_id" type="text" placeholder="app_..." autocomplete="off" />
          <small>Developer Portal の app_id（app_...）</small>
        </div>

        <div class="field">
          <label for="rp-id">rp_id</label>
          <input id="rp-id" name="rp_id" type="text" placeholder="rp_..." autocomplete="off" />
          <small>Developer Portal の rp_id（rp_...）</small>
        </div>

        <div class="field">
          <label for="action">action</label>
          <input id="action" name="action" type="text" value="register" autocomplete="off" />
          <small>verifier の WORLD_ACTION と一致させてください（既定: register）</small>
        </div>

        <div class="field">
          <label for="environment">environment</label>
          <select id="environment" name="environment">
            <option value="production">production</option>
            <option value="staging">staging（simulator 用）</option>
          </select>
          <small>テスト時は simulator を使うため staging を選択します。</small>
        </div>

        <div class="actions">
          <button id="start-button" type="submit">検証を開始</button>
          <button id="reset-button" type="button" class="secondary">リセット</button>
        </div>
      </form>
    </section>

    <section class="card">
      <h2>
        状態
        <span id="status-panel" data-state="idle" class="status">
          <span class="dot"></span><span id="status-label">待機中</span>
        </span>
      </h2>

      <div id="spinner" hidden class="spinner" aria-hidden="true"></div>

      <div id="message-box" hidden class="message">
        この QR コードを World App で読み取り、画面の指示に従って証明を完了してください。
      </div>

      <div id="qr-section" hidden class="qr-section">
        <canvas id="qr-canvas"></canvas>
        <div class="connect">
          <span>接続 URL:</span>
          <a id="connect-link" href="#" target="_blank" rel="noopener noreferrer"></a>
        </div>
      </div>
    </section>

    <section id="result-section" hidden class="card success">
      <h2>検証結果</h2>
      <p class="ok">✓ verifier による検証に成功しました。</p>
      <pre id="result-json"></pre>
    </section>

    <section id="error-section" hidden class="card error">
      <h2 id="error-title"></h2>
      <p id="error-hint"></p>
      <pre id="error-detail" hidden></pre>
    </section>

    <section id="debug-section" hidden class="card">
      <h2>Debug report</h2>
      <details>
        <summary>IDKit の診断情報を表示（開発時のみ）</summary>
        <pre id="debug-json"></pre>
      </details>
    </section>
  </main>
</Layout>

<style>
  main {
    max-width: 760px;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  header h1 {
    margin: 0 0 0.25rem;
    font-size: 1.6rem;
  }

  .subtitle {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.25rem 1.4rem;
  }

  .card h2 {
    margin: 0 0 1rem;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin-bottom: 1rem;
  }

  .field label {
    font-weight: 600;
    font-size: 0.9rem;
  }

  .field small {
    color: var(--muted);
    font-size: 0.78rem;
  }

  input,
  select {
    background: var(--panel-2);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.55rem 0.7rem;
    color: var(--text);
    font-size: 0.95rem;
  }

  input:focus,
  select:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .actions {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  button {
    background: var(--accent);
    color: white;
    border: none;
    border-radius: 8px;
    padding: 0.6rem 1.2rem;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
  }

  button.secondary {
    background: var(--panel-2);
    color: var(--text);
    border: 1px solid var(--border);
  }

  button:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
  }

  .status .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--muted);
  }

  .status[data-state="requesting-signature"] .dot,
  .status[data-state="waiting"] .dot,
  .status[data-state="verifying"] .dot {
    background: var(--warn);
  }

  .status[data-state="verified"] {
    color: var(--ok);
  }

  .status[data-state="verified"] .dot {
    background: var(--ok);
  }

  .status[data-state="error"] {
    color: var(--err);
  }

  .status[data-state="error"] .dot {
    background: var(--err);
  }

  .message {
    color: var(--muted);
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .spinner {
    width: 24px;
    height: 24px;
    border: 3px solid var(--border);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: spin 0.9s linear infinite;
    margin: 0.5rem 0 1rem;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .qr-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  #qr-canvas {
    background: white;
    border-radius: 10px;
    padding: 6px;
  }

  .connect {
    font-size: 0.8rem;
    color: var(--muted);
    text-align: center;
  }

  pre {
    background: var(--panel-2);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.9rem;
    overflow-x: auto;
    font-size: 0.8rem;
    white-space: pre-wrap;
    word-break: break-word;
    max-height: 420px;
    overflow-y: auto;
  }

  .success {
    border-color: var(--ok);
  }

  .success .ok {
    color: var(--ok);
    font-weight: 600;
    margin-top: 0;
  }

  .error {
    border-color: var(--err);
  }

  .error h2 {
    color: var(--err);
  }

  details summary {
    cursor: pointer;
    color: var(--muted);
    font-size: 0.88rem;
  }
</style>

<script>
  import { initVerificationFlow } from "../scripts/idkit-flow";

  initVerificationFlow();
</script>
