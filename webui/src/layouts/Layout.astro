---
interface Props {
  title?: string;
}

const { title = "World ID 4.0 検証フロントエンド" } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg: #0b0f17;
    --panel: #151b26;
    --panel-2: #1c2432;
    --border: #2a3444;
    --text: #e7edf5;
    --muted: #93a1b5;
    --accent: #4f8cff;
    --ok: #35c26a;
    --warn: #e0a13a;
    --err: #e05555;
    color-scheme: dark;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    min-height: 100%;
  }

  body {
    background: var(--bg);
    color: var(--text);
    font-family:
      system-ui,
      -apple-system,
      "Segoe UI",
      "Hiragino Kaku Gothic ProN",
      "Noto Sans JP",
      sans-serif;
    line-height: 1.6;
  }

  a {
    color: var(--accent);
    word-break: break-all;
  }

  code,
  pre {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
</style>
